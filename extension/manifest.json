{
  "manifest_version": 3,
  "name": "Form Copilot",
  "version": "1.0.0",
  "description": "Detect form fields, map to CRM schema, and autofill with stored client data.",
  "permissions": ["activeTab", "storage", "scripting", "webNavigation"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
